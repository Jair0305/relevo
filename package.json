{
  "name": "relevo-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Laboratorio local para ver, con ejecuciones reales de Concord MCP, cuándo la coordinación evita choques entre agentes de código.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node server/main.ts",
    "check": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "capture": "node scripts/capture.ts",
    "browser-check": "node scripts/browser-check.ts",
    "verify": "npm run check && npm test && npm run browser-check"
  },
  "dependencies": {
    "@concord-ai/concord-mcp": "0.19.0",
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3"
  }
}
